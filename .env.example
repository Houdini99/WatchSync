# Public origin clients connect from. Used for the server's HTTP/WebSocket CORS.
# Set this to your https URL once your reverse proxy is fronting the stack.
# Use * during initial testing only. Comma-separate to allow multiple origins.
PUBLIC_ORIGIN=https://watch.example.com

# Server log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info

# yt-dlp resolver sidecar for Vimeo/Twitch/Dailymotion/Reddit/… links.
# Defaults to the bundled service. Set to empty to disable it entirely
# (/api/resolve then returns 501 and non-native links are best-effort only).
# RESOLVER_URL=http://watchsync-resolver:8080

# PO-token provider (the watchsync-bgutil sidecar) used by the resolver when
# extracting YouTube subtitles. YouTube rejects auto-translated caption
# requests without this attestation. Set to empty to disable — subtitle
# listing still works, translated tracks will usually 429.
# POT_PROVIDER_URL=http://watchsync-bgutil:4416

# Pasted media URLs are fetched server-side (ffmpeg/yt-dlp), so URLs resolving
# to private/LAN addresses are refused by default (SSRF guard). Set true to
# play media from your LAN (Jellyfin/NAS) — only on a non-public instance.
# ALLOW_PRIVATE_URLS=false

# RAM-backed volume for the per-room HLS proxy. A proxied VOD stays on it in
# full while the room lives — size for your longest/highest-bitrate file.
# Changing it later: docker compose down && docker volume rm the old volume.
# STREAMS_TMPFS_SIZE=2g

# ---- Optional accounts (SQLite on the watchsync-data volume) ----
# Guests need nothing; registering unlocks permanent custom room URLs
# (/r/movie-night) where the owner is always host.
# Set false to close signups — existing accounts keep working.
# REGISTRATION_ENABLED=true
# Max custom room names one account may hold.
# MAX_ROOMS_PER_USER=5
# The session cookie is HTTPS-only by default. Set false ONLY for a plain-HTTP
# LAN install with no reverse proxy in front.
# COOKIE_SECURE=true

# ---- Optional tunables ----
# The variables above are substituted into docker-compose.yml as-is. The ones
# below are NOT referenced there yet — uncomment the matching line in the
# service's `environment:` block to apply them. Values shown are the defaults.
# MAX_USERS_PER_ROOM=50
# MAX_ROOMS=5000
# MAX_QUEUE_LENGTH=200
# CHAT_HISTORY_LIMIT=80
# SESSION_TTL_DAYS=30                       # sliding session cookie lifetime
# EMPTY_ROOM_TTL_MS=300000                  # auto-reap empty, non-persistent rooms after 5 min
# RECONNECT_GRACE_MS=12000                  # keep a dropped user's seat this long before "left"
# HEARTBEAT_MS=4000                         # drift-correction broadcast interval
# DRIFT_TOLERANCE_SEC=1.5                   # how far out of sync before a hard correction
# ALLOWED_RATES=0.25,0.5,0.75,1,1.25,1.5,1.75,2   # playback speeds offered in the UI
# HLS_SEGMENT_SEC=4                         # target HLS segment length
# STREAM_AUDIO_BITRATE=192k                 # AAC bitrate for the transcoded audio track
# STREAM_READY_TIMEOUT_SEC=30               # wait for ffmpeg's first playlist before failing
