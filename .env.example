# Public origin clients connect from. Used for Socket.IO + HTTP CORS.
# Set this to your https URL once NPM is fronting the stack.
# Use * during initial testing only. Comma-separate to allow multiple origins.
PUBLIC_ORIGIN=https://watch.example.com

# Server log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info

# ---- Optional tunables (uncomment to override server/src/config.js defaults) ----
# MAX_USERS_PER_ROOM=50
# MAX_ROOMS=5000
# MAX_QUEUE_LENGTH=200
# CHAT_HISTORY_LIMIT=80
# EMPTY_ROOM_TTL_MS=300000        # auto-reap empty, non-persistent rooms after 5 min
# RECONNECT_GRACE_MS=12000        # keep a dropped user's seat this long before "left"
# HEARTBEAT_MS=4000               # drift-correction broadcast interval
# DRIFT_TOLERANCE_SEC=1.5         # how far out of sync before a hard correction
# ALLOWED_RATES=0.5,1,1.25,1.5,2  # playback speeds offered in the UI
